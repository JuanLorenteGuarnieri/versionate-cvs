{
  "name": "versionate-cvs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "tsx --test \"src/**/*.test.ts\" --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --project tsconfig.app.json --noEmit",
    "manual:indexeddb:build": "tsc --project tsconfig.manual-indexeddb.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "pdfjs-dist": "^5.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^6.0.0",
    "pdf-lib": "^1.17.1"
  },
  "homepage": "https://juanlorenteguarnieri.github.io/versionate-cvs"
}